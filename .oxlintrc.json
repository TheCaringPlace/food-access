{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    // SST loads generated platform types through this required reference.
    "typescript/triple-slash-reference": "off",
    // The project uses React's automatic JSX runtime (react-jsx).
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "builtin": true
  }
}
