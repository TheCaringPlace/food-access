{
  "name": "food-access-points",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run data:build && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "test:all": "pnpm test && pnpm run test:e2e",
    "analyze": "pnpm run data:build && tsc -b && vite build --mode analyze",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error src scripts vite.config.ts sst.config.ts",
    "format": "oxfmt --write src scripts tests playwright.config.ts vitest.config.ts index.html package.json tsconfig.json vite.config.ts sst.config.ts",
    "format:check": "oxfmt --check src scripts tests playwright.config.ts vitest.config.ts index.html package.json tsconfig.json vite.config.ts sst.config.ts",
    "sst": "sst",
    "sst:dev": "sst dev",
    "sst:deploy": "sst deploy",
    "sst:remove": "sst remove",
    "data:geocode": "node scripts/geocode-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:refresh-kml": "node scripts/refresh-kml.mjs",
    "data:update": "pnpm run data:refresh-kml && pnpm run data:geocode && pnpm run data:build"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-xml-parser": "^5.12.1",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "sst": "^4.17.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zipcodes": "^8.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
